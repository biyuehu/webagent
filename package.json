{
  "name": "webagentx",
  "description": "DSL-driven web AI agent for file operations, code modification, and command execution",
  "version": "1.4.2",
  "author": "ArimuraSena <i@arimuraromi.com>",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./src/index.ts",
  "bin": {
    "webagentx": "./dist/cli.js",
    "wa": "./dist/cli.js",
    "ro": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "init": "bunx lefthook install",
    "fix": "biome check --write",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node && bun build src/index.ts --outfile dist/index.js --target node && tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "version": "bun run changelog && git add CHANGELOG.md",
    "changelog": "bunx changelogen --output CHANGELOG.md",
    "release": "bun run changelog && bun run build && bun publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "ap": "bun bin apply",
    "pa": "bun bin pack",
    "lo": "bun bin loop"
  },
  "keywords": [
    "ai-agent",
    "dsl",
    "file-operations",
    "code-generation",
    "cli",
    "bun",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biyuehu/webagent.git"
  },
  "files": [
    "dist",
    "src",
    "bin.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "@biomejs/biome": "2.4.13",
    "changelogen": "^0.5.7",
    "lefthook": "^2.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cac": "^7.0.0",
    "clipboardy": "^5.3.2",
    "picocolors": "^1.1.1",
    "remark": "^15.0.1",
    "staron": "1.3.2",
    "tinyglobby": "^0.2.17"
  }
}
